# Copy this file to .env before deploying with Docker Compose.
# Generate a real secret with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Host port exposed on the Docker host.
HOST_PORT=8000

# Django runtime.
DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:////data/flashcram.sqlite3

# Comma-separated hosts that may serve the app.
# For LAN-only testing, include your server IP. For a reverse proxy, include the public hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.0.10,flashcram.example.com

# Required when submitting forms through an HTTPS reverse proxy.
# Include scheme and hostname, comma-separated if you have more than one.
CSRF_TRUSTED_ORIGINS=https://flashcram.example.com

# Reverse proxy / HTTPS options.
# Set these True when a proxy terminates HTTPS and forwards X-Forwarded-Proto: https.
USE_X_FORWARDED_HOST=False
SECURE_PROXY_SSL_HEADER=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
