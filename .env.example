# Copy this file to .env before deploying with Docker Compose.
# Generate a real secret with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Host port exposed on the Docker host.
HOST_PORT=8000

# Django runtime.
DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret

# Production/Postgres. Start Docker with COMPOSE_PROFILES=postgres.
DATABASE_URL=postgres://flashcram:flashcram@postgres:5432/flashcram
POSTGRES_DB=flashcram
POSTGRES_USER=flashcram
POSTGRES_PASSWORD=replace-this-postgres-password

# For the staged SQLite -> Postgres owner migration only:
# FLASHCRAM_MIGRATE_TARGET=cards 0006_multi_user_nullable

# Comma-separated hosts that may serve the app.
# For LAN-only testing, include your server IP. For a reverse proxy, include the public hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.0.10,flashcram.example.com

# Required when submitting forms through an HTTPS reverse proxy.
# Include scheme and hostname, comma-separated if you have more than one.
CSRF_TRUSTED_ORIGINS=https://flashcram.example.com

# Reverse proxy / HTTPS options.
# Set these True when a proxy terminates HTTPS and forwards X-Forwarded-Proto: https.
USE_X_FORWARDED_HOST=False
SECURE_PROXY_SSL_HEADER=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Non-rolling Django session lifetime. Users re-authenticate after this many days.
SESSION_EXPIRE_DAYS=5

# Authentik / OIDC explicit login option.
# Authentik redirect URI should be:
#   https://flashcram.example.com/oidc/callback/
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.example.com/application/o/flashcram/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.example.com/application/o/flashcram/token/
OIDC_OP_USER_ENDPOINT=https://auth.example.com/application/o/flashcram/userinfo/
OIDC_OP_JWKS_ENDPOINT=https://auth.example.com/application/o/flashcram/jwks/
OIDC_RP_SCOPES=openid email profile
OIDC_RP_SIGN_ALGO=RS256

# Optional first local admin. Recommended for first deploys and as a fallback
# if OIDC is not configured yet. Remove the password after the first successful start
# if you do not want it kept in your .env.
# If Authentik later sends the same preferred_username/email, that OIDC user will
# inherit staff/superuser access.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
